# Meta Model API (https://dev.meta.ai): SAM 3.1, Muse Voice Transcribe, Muse Spark 1.3 fallback
MODEL_API_KEY=

# Baseten: Muse Spark Open, the primary reasoning model
BASETEN_API_KEY=
# baseten (Spark Open, with automatic logged fallback to Meta) | meta (Spark 1.3 only)
REASONING_PROVIDER=baseten

# Model endpoints and ids (defaults shown; override only to point at another deployment)
# Meta Model API base URL (Files, SAM, ASR, Spark 1.3 chat completions)
META_API_BASE=https://api.meta.ai/v1
# Baseten OpenAI-compatible base URL
BASETEN_API_BASE=https://inference.baseten.co/v1
# Hackathon slug, tried first
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# JSON list tried in order when SPARK_OPEN_MODEL returns 404 (Nov 3 probe: -1026 404'd, this answered)
SPARK_OPEN_MODEL_ALTERNATES=["meta-models/muse-spark-open"]
# Meta-hosted fallback reasoning model
SPARK_FALLBACK_MODEL=muse-spark-1.3
# SAM model id for /v1/responses
SAM_MODEL=sam-3.1
# Muse Voice Transcribe model id for /v1/asr/transcribe
ASR_MODEL=muse-voice-transcribe-1.0
# per-request HTTP timeout in seconds (SAM video streams can take minutes)
HTTP_TIMEOUT_S=300

# App
DATA_DIR=./data
APP_BASE_URL=http://localhost:8000
DEMO_MODE=false
# Send verified items to their trades automatically after a first walk is processed (PLAN 6.2)
AUTO_SEND=true
# Trust X-Forwarded-For for the client IP (rate limiting). Only behind a proxy you control.
# On Fly, Fly-Client-IP is used instead; Fly sets FLY_APP_NAME itself, don't set it here.
TRUST_PROXY=false
# In-process job worker: 1 = on (two job threads), 0 = off (tests drive jobs themselves)
PUNCHWALK_WORKER=1
# DEMO_MODE: uploads per device per hour
DEMO_UPLOADS_PER_HOUR=3
# Re-seed the demo project (prj_demo) from DEMO_SNAPSHOT on boot and nightly at DEMO_RESEED_AT (America/New_York)
DEMO_RESEED=false
DEMO_RESEED_AT=03:00
DEMO_SNAPSHOT=demo/seed_snapshot.tar.gz
# Boot reset: a new value (vs DATA_DIR/.demo_reset_token) drops EVERY project once at boot, then re-imports the demo; empty = never
DEMO_RESET_TOKEN=

# Cache: readwrite | readonly | off (tests force readonly)
PUNCHWALK_CACHE=readwrite
# defaults: DATA_DIR/cache and fixtures/cache
PUNCHWALK_CACHE_DIR=
FIXTURE_CACHE_DIR=fixtures/cache

# Pipeline
# point+voice (the fingertip locates each defect) | voice_only (ignore pointing)
GROUNDING_MODE=point+voice
# 1 = defect outline v2: Spark Open locates the defect itself, SAM 3.1 box/point prompts, scored + checked
# production (fly.toml) runs GROUNDING_V2=1; keep 0 for dev so `make eval` replays the recorded v1 calls
GROUNDING_V2=0
# 1 = with GROUNDING_V2, re-ground protected items too (evidence/outline only; text, status, closures untouched)
REGROUND_ALL=0
# SAM 3.1 concept for the pointing hand ("hand", "index finger", "pointing hand"; make record picks)
SAM_HAND_CONCEPT=hand
# hard cap on live Meta + Baseten spend (ledger: DATA_DIR/cost_ledger.jsonl)
COST_CAP_USD=25
# live spend per calendar day (America/New_York); a walk that would pass it fails with a readable message
COST_DAILY_CAP_USD=10

# Dispatch (optional; without these, messages go to the in-app outbox)
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Deploy (optional; `fly auth login` on this machine also works)
FLY_API_TOKEN=
