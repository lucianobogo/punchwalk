# Punchwalk environment
# Copy this file to .env and fill in the two REQUIRED keys. Everything else already has a working value.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED — the app will not process a walk without these two
# ─────────────────────────────────────────────────────────────────────────────

# Meta Model API key (https://dev.meta.ai) — used for SAM 3.1, Muse Voice Transcribe and the Muse Spark 1.3 fallback
MODEL_API_KEY=

# Baseten API key (https://baseten.co) — used for Muse Spark Open, the open-weights model that does all the reasoning
BASETEN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. OPTIONAL — sending punch lists to trades
#    Leave blank and every list is still shared with "Copy link" inside the app.
# ─────────────────────────────────────────────────────────────────────────────

# Team Slack incoming webhook. Trades without their own Slack webhook post here.
SLACK_WEBHOOK_URL=

# Email through Resend (https://resend.com). Both values are needed to email a trade's list.
RESEND_API_KEY=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SETTINGS — safe defaults for running locally; change only if you need to
# ─────────────────────────────────────────────────────────────────────────────

# Where the SQLite database, media files and the API cache live
DATA_DIR=./data

# Public URL used in share links and in Slack/email messages
APP_BASE_URL=http://localhost:8000

# Send verified items to their trades automatically after a first walk is processed (true | false)
AUTO_SEND=true

# Live-spend caps in USD: total, and per calendar day (America/New_York). Ledger: DATA_DIR/cost_ledger.jsonl
COST_CAP_USD=25
COST_DAILY_CAP_USD=10

# Defect outlines: 1 = v2 (Spark Open locates the defect, SAM 3.1 outlines it, Spark Open checks the outline).
# Production runs 1. Keep 0 locally so `make eval` replays the recorded run exactly.
GROUNDING_V2=0

# point+voice (the fingertip locates each defect) | voice_only (ignore pointing)
GROUNDING_MODE=point+voice

# API response cache: readwrite | readonly | off  (tests force readonly and replay fixtures/cache)
PUNCHWALK_CACHE=readwrite

# Reasoning provider: baseten (Muse Spark Open, with a logged fallback to Meta) | meta (Muse Spark 1.3 only)
REASONING_PROVIDER=baseten

# Model ids and endpoints. The hackathon slug is tried first; the catalog slug answers if it returns 404.
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
SPARK_OPEN_MODEL_ALTERNATES=["meta-models/muse-spark-open"]
SPARK_FALLBACK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
META_API_BASE=https://api.meta.ai/v1
BASETEN_API_BASE=https://inference.baseten.co/v1

# Per-request HTTP timeout in seconds (SAM video streams can take minutes)
HTTP_TIMEOUT_S=300

# In-process job worker: 1 = on (default), 0 = off (the tests drive jobs themselves)
PUNCHWALK_WORKER=1

# ─────────────────────────────────────────────────────────────────────────────
# 4. HOSTED DEMO ONLY — what punchwalk.fly.dev sets in fly.toml; not needed to run locally
# ─────────────────────────────────────────────────────────────────────────────

# Demo mode: per-device upload limit and a plain refusal when the daily budget is used up
DEMO_MODE=false
DEMO_UPLOADS_PER_HOUR=3

# Re-import the demo project from the snapshot on boot and nightly at DEMO_RESEED_AT (America/New_York)
DEMO_RESEED=false
DEMO_RESEED_AT=03:00
DEMO_SNAPSHOT=demo/seed_snapshot.tar.gz

# Change this value and redeploy to wipe every uploaded project once at boot (the demo is re-imported). Empty = never.
DEMO_RESET_TOKEN=

# Trust X-Forwarded-For for the client IP. Only behind a proxy you control (Fly uses Fly-Client-IP instead).
TRUST_PROXY=false

# Deploy token for `make deploy` (`fly auth login` on this machine works instead)
FLY_API_TOKEN=
