# Punchwalk — copy to .env and fill in the two keys below. Everything else has a working default.

# ── Required ───────────────────────────────────────────────────────────────────
# Meta Model API key (https://dev.meta.ai): SAM 3.1, Muse Voice Transcribe, Muse Spark 1.3 fallback
MODEL_API_KEY=
# Baseten API key (https://baseten.co): Muse Spark Open, the model that does all the reasoning
BASETEN_API_KEY=

# ── Optional: sending punch lists to trades ───────────────────────────────────
# Without these, every list is still shared with "Copy link" in the app.
# Team Slack incoming webhook (trades without their own Slack post here)
SLACK_WEBHOOK_URL=
# Email via Resend (https://resend.com) — both needed to email a trade's list
RESEND_API_KEY=
EMAIL_FROM=

# ── Advanced (defaults shown; uncomment only to change) ───────────────────────
# Where the SQLite database, media and the API cache live
# DATA_DIR=./data
# Public URL used in share links and Slack/email messages
# APP_BASE_URL=http://localhost:8000
# Send verified items to their trades automatically after a first walk (true | false)
# AUTO_SEND=true
# Live-spend caps in USD (total, and per America/New_York day); ledger at DATA_DIR/cost_ledger.jsonl
# COST_CAP_USD=25
# COST_DAILY_CAP_USD=10
# Defect outlines v2 (Spark Open locates, SAM 3.1 outlines, Spark Open checks). 1 in production;
# keep 0 for dev so `make eval` replays the recorded run
# GROUNDING_V2=0
# point+voice (the fingertip locates each defect) | voice_only (ignore pointing)
# GROUNDING_MODE=point+voice
# API cache: readwrite | readonly | off (tests force readonly)
# PUNCHWALK_CACHE=readwrite
# Reasoning provider: baseten (Spark Open, logged fallback to Meta) | meta (Spark 1.3 only)
# REASONING_PROVIDER=baseten
# Model ids and endpoints (override only to point at another deployment)
# SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# SPARK_OPEN_MODEL_ALTERNATES=["meta-models/muse-spark-open"]
# SPARK_FALLBACK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# ASR_MODEL=muse-voice-transcribe-1.0
# META_API_BASE=https://api.meta.ai/v1
# BASETEN_API_BASE=https://inference.baseten.co/v1
# HTTP_TIMEOUT_S=300
# In-process job worker: 1 = on, 0 = off (tests drive jobs themselves)
# PUNCHWALK_WORKER=1
# Hosted-demo knobs (set in fly.toml for punchwalk.fly.dev; not needed locally):
# DEMO_MODE=false · DEMO_UPLOADS_PER_HOUR=3 · DEMO_RESEED=false · DEMO_RESEED_AT=03:00
# DEMO_SNAPSHOT=demo/seed_snapshot.tar.gz · DEMO_RESET_TOKEN= · TRUST_PROXY=false
# Deploy token for `make deploy` (`fly auth login` works instead)
# FLY_API_TOKEN=
